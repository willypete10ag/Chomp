# Copy to .env and fill in. Never commit .env.
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=

# Optional: User-Agent sent to Open Food Facts (they ask for an app name and contact)
# OFF_USER_AGENT=Chomp/0.1 (you@example.com)

# --- Endpoint auth (M3). Leave PUBLIC_URL blank for local-only use on 127.0.0.1. ---
# The https address Claude connects to, no trailing slash or path.
PUBLIC_URL=
# The owner's password, for the "Connect Claude to Chomp" page you see once when adding the
# connector and for the dashboard. At least 12 characters. Other people get their own with
# `chomp user add NAME` (README, step 8).
AUTH_PASSWORD=
# OAuth client Claude uses: enter both in Claude's "Add custom connector" dialog.
OAUTH_CLIENT_ID=claude-chomp
OAUTH_CLIENT_SECRET=
# Optional fixed token, accepted as "Authorization: Bearer <token>" (MCP Inspector, or the
# connector's Request headers option). Blank turns it off.
BEARER_TOKEN=

# --- Cloudflare Tunnel (Docker Compose only) ---
# Token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel.
TUNNEL_TOKEN=

# --- Backups ---
# Host folder for nightly copies (Docker Compose only). Must be writable by uid 10001.
BACKUP_HOST_DIR=./backups
# Local time to back up, and how many nightly copies to keep.
BACKUP_AT=03:30
BACKUP_KEEP=14

# SQLite database path (local runs; the container always uses /data/chomp.db)
DB_PATH=./chomp.db

# Display timezone for day boundaries and summaries
TZ=America/New_York
