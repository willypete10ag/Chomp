# Copy to .env and fill in. Never commit .env.

# USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup)
FDC_API_KEY=

# Optional: User-Agent sent to Open Food Facts (they ask for an app name and contact)
# OFF_USER_AGENT=Chomp/0.1 (you@example.com)

# Long random secret for endpoint auth (M3). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# SQLite database path
DB_PATH=./chomp.db

# Display timezone for day boundaries and summaries
TZ=America/New_York
